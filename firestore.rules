rules_version = '2';

// Security rules for the SCB Event Registration platform.
//
// Trust model (current, post-Phase-C dedupe-collection refactor):
//   - PII is AES-256-GCM encrypted in the browser before write.
//   - /events: public read (QR resolves event id without auth), admin write.
//   - /registrations, /checkins, /checkouts: PII-bearing collections.
//     ADMIN-ONLY READ. Public WRITE with shape validation. An attacker who
//     has the bundle (and therefore the AES key) cannot enumerate ciphertext
//     because reads are locked.
//   - /dedupe: lightweight existence map. Public read + write. Each doc
//     stores only {eventId, dedupeHash, kind, lastSubmittedAt, expiresAt}.
//     Hash is SHA-256-with-event-salt — irreversible. Anonymous participants
//     use /dedupe to detect their own duplicate submission without needing
//     read access on the PII collection.
//   - /attendance: admin-only end-to-end (computed roll-up).
//   - /audit, /users: admin-only.
//
// V2 (planned): Cloud Function decrypt envelope so the AES key lives only in
// Google Secret Manager. Decryption only happens through an authenticated,
// audited function call.

service cloud.firestore {
  match /databases/{database}/documents {

    function hasEncryptedShape(field) {
      return field is string
        && field.size() <= 12000  // 10k plaintext ~13k base64 ciphertext. Blocks ~1MB DoS writes.
        && (field.size() == 0 || field.matches('^enc:v[12]:.+\\..+'));
    }

    function hasValidDedupeHash(h) {
      // SHA-256 first-24-hex-chars per crypto.js hashDedupeValue. Reject
      // empty / forged hashes that would let an attacker squat docId
      // `${eventId}__` and collide with legitimate writes.
      return h is string && h.size() == 24 && h.matches('^[0-9a-f]{24}$');
    }

    function isValidEventRef(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    function eventIsActive(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.status == 'active';
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /events/{eventId} {
      // Public read so QR scans can resolve event id without auth.
      allow read: if true;
      // Writes are admin-only.
      allow create, update, delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      // ADMIN-ONLY READ. Duplicate detection moved to /dedupe (public
      // existence-only map). Anonymous participants no longer touch this
      // collection during their own duplicate-check flow.
      allow read: if isAdmin();
      // Public write — anonymous participants submit ciphertext via the QR.
      allow create, update: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && eventIsActive(request.resource.data.eventId)
        && hasEncryptedShape(request.resource.data.fullName)
        && hasEncryptedShape(request.resource.data.employeeId)
        && hasEncryptedShape(request.resource.data.email)
        && hasEncryptedShape(request.resource.data.phone)
        // Back-compat: accept ciphertext OR legacy clear values so
        // participants on stale browser caches don't silently fail
        // permission-denied. New bundles ship encrypted strings; older
        // cached bundles still pass.
        && (
          hasEncryptedShape(request.resource.data.participation)
          || request.resource.data.participation in ['Yes', 'No']
        )
        && (
          hasEncryptedShape(request.resource.data.photoConsent)
          || request.resource.data.photoConsent is bool
        )
        && hasValidDedupeHash(request.resource.data.dedupeHash);
      allow delete: if isAdmin();
    }

    match /checkins/{checkInId} {
      // ADMIN-ONLY READ. /dedupe holds the existence map for duplicate
      // check-in detection.
      allow read: if isAdmin();
      allow create: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && eventIsActive(request.resource.data.eventId)
        && hasEncryptedShape(request.resource.data.uniqueId)
        && hasEncryptedShape(request.resource.data.fullName)
        && request.resource.data.walkInFlag is bool
        && hasValidDedupeHash(request.resource.data.dedupeHash);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /checkouts/{checkOutId} {
      // ADMIN-ONLY READ. /dedupe holds the existence map.
      allow read: if isAdmin();
      allow create: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && hasEncryptedShape(request.resource.data.uniqueId)
        && hasEncryptedShape(request.resource.data.fullName)
        && request.resource.data.walkInFlag is bool
        && hasValidDedupeHash(request.resource.data.dedupeHash);
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      // Roll-up of registrations + checkins + checkouts. Admin-only end-to-end.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Public existence-map. Stores only {eventId, dedupeHash, kind,
    // lastSubmittedAt, expiresAt}. Hash is SHA-256-with-event-salt —
    // irreversible, leaks no PII. Used so anonymous participants can
    // self-detect duplicates without read access on /registrations etc.
    // Doc id format: `{kind}-{eventId}__{hash}` (kind: 'reg'|'ci'|'co').
    match /dedupe/{dedupeId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.eventId is string
        && isValidEventRef(request.resource.data.eventId)
        && eventIsActive(request.resource.data.eventId)
        && hasValidDedupeHash(request.resource.data.dedupeHash)
        && request.resource.data.kind in ['reg', 'ci', 'co'];
      allow delete: if isAdmin();
    }

    // Audit log — append-only record of admin actions. Reads admin-only;
    // creates admin-only. No updates, no deletes — once written, an audit
    // row is immutable. Operator email is encrypted at rest. Anti-forgery:
    // the actorUid MUST equal the authenticated user — one admin cannot
    // forge an audit row attributing an action to another admin. Action
    // strings restricted to the known vocabulary so the audit table can't
    // be filled with garbage to obscure real entries.
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action in [
          'sign-in', 'sign-out',
          'event-create', 'event-edit', 'event-close', 'event-reopen',
          'event-delete', 'event-reset',
          'csv-export', 'reveal',
          'user-add', 'user-remove',
          'key-rotate'
        ]
        && hasEncryptedShape(request.resource.data.actorEmail)
        && hasEncryptedShape(request.resource.data.targetLabel);
      allow update, delete: if false;
    }

    // Admin user directory. The auth user is the gate; this collection just
    // mirrors Firebase Auth users so the in-app Users page can list them
    // (client SDK can't enumerate auth users on its own). Self-read so
    // signIn() can verify the just-signed-in user is on the allowlist.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }
  }
}
